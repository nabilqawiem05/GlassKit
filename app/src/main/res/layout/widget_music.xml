<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/w_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_art_bg"
            android:elevation="6dp"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textFontWeight="700"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/w_prog"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="4dp"
                android:max="1000"
                android:progress="0" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/w_prev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/widget_btn_glass"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_prev"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/w_play"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/widget_btn_glass"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_play"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/w_next"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/widget_btn_glass"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_next"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
