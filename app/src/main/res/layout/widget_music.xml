<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_clear"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_art_bg"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textFontWeight="700"
                android:maxLines="1"
                android:textColor="@color/widget_fg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_fg_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/w_prev"
                    android:layout_width="42dp"
                    android:layout_height="40dp"
                    android:background="@null"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_prev"
                    android:tint="@color/widget_fg" />

                <ImageButton
                    android:id="@+id/w_play"
                    android:layout_width="46dp"
                    android:layout_height="40dp"
                    android:background="@null"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_play"
                    android:tint="@color/widget_fg" />

                <ImageButton
                    android:id="@+id/w_next"
                    android:layout_width="42dp"
                    android:layout_height="40dp"
                    android:background="@null"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_next"
                    android:tint="@color/widget_fg" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
